aws_region   = "us-east-1"
project_name = "commutenest"
environment  = "dev"

enable_dynamodb_deletion_protection    = false
enable_dynamodb_point_in_time_recovery = false

budget_alert_email = "your-email@example.com"
alert_emails       = ["your-email@example.com"]

# Optional. Use E.164 format. These values are stored in Terraform state.
# sms_subscriber_numbers = ["+14155552671"]

tags = {
  Owner = "your-name"
}
