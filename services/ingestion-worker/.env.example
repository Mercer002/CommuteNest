# Phase 1 defaults run against fixtures with deterministic mock commute times.
DISTANCE_PROVIDER=mock
LISTING_SOURCE_KIND=rss
LISTING_SOURCE_URL=fixtures/sample-listings.rss

# Set DISTANCE_PROVIDER=google and provide this key to call Google Maps.
GOOGLE_MAPS_API_KEY=
GOOGLE_DEPARTURE_TIME=now

# User preference inputs. These later move to DynamoDB behind an API.
MAX_RENT_USD=1800
MAX_COMMUTE_MINUTES=35
TARGET_DESTINATION=Union Station, Toronto, ON
TRANSIT_MODE=transit
TRANSIT_MODES=bus,subway,train

# Local state and alert behavior.
SEEN_LISTINGS_FILE=.local/seen-listings.json
DRY_RUN_ALERTS=true
